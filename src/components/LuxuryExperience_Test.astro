---
import {
  Music,
  Dices,
  PartyPopper,
  Martini,
  Utensils,
  Gamepad2,
} from "lucide-astro";

import videoSrc from "../assets/video/hero-video.webm";

const features = [
  { icon: Music, title: "Live", subtitle: "Performances" },
  { icon: Dices, title: "10+", subtitle: "Games" },
  { icon: PartyPopper, title: "Festive", subtitle: "Fun" },
  { icon: Martini, title: "Drinks &", subtitle: "Cocktails" },
  { icon: Utensils, title: "Delicious", subtitle: "Food" },
  { icon: Gamepad2, title: "Gaming", subtitle: "Experience" },
];
---

<link
  rel="stylesheet"
  href="../../node_modules/lite-youtube-embed/src/lite-yt-embed.css"
/>

<script src="../../node_modules/lite-youtube-embed/src/lite-yt-embed.js"
></script>

<section class="luxury-experience">
  <div class="container">
    <div class="content">
      <div class="title-section">
        <h2 class="heading">OUR LUXURY EXPERIENCE</h2>
        <div class="underline"></div>
      </div>

      <div class="lft">
        <p class="description">
          Phoenixx Casino Goa offers a luxury gaming destination in Candolim, a
          Hilton Goa resort. Join us to experience fun, entertainment, and
          unlimited luck at our Casino.
        </p>

        <div class="features">
          {
            features.map((feature) => (
              <div class="feature">
                <div class="icon-circle">
                  <feature.icon size="24" color="#000" />
                </div>
                <div class="feature-text">
                  <h3>{feature.title}</h3>
                  <p>{feature.subtitle}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <a href="/contact" class="book-now">BOOK NOW</a>
    </div>

    <div class="video-container">
      <video
        src={videoSrc}
        title="Phoenixx Casino Promo"
        autoplay
        muted
        loop
        class="video-element"
      >
      </video>
    </div>
  </div>
</section>

<style>
  .video-element {
    object-fit: cover;
    min-width: 100%;
    min-height: 100%;
  }

  .heading {
    font-size: 2.5rem;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    position: relative;
    z-index: 3;
  }

  .lft {
    width: 100%;
    max-width: 600px;
    min-width: 150px;
    margin: 0 auto;
  }

  .luxury-experience {
    background-color: #000;
    color: #fff;
    padding: 0;
    margin-top: 20px;
    padding-top: 20px;
    width: 100%;
    overflow: visible;
  }
  //
  .luxury-experience .container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: flex-start;
  }
  .container {
    max-width: 1200px;
    min-width: 150px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: flex-start;
  }

  .title-section {
    margin-bottom: 2rem;
    width: 100%;
    max-width: 1200px;
    min-width: 150px;
    margin: 0;
    text-align: left;
  }

  h2 {
    font-size: 2.5rem;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    width: 100%;
    max-width: 1200px;
    min-width: 150px;
    margin: 0 auto;
  }
  h2::after {
    content: "";
    display: block;
    width: 80px;
    height: 3px;
    background-color: #d4af37;
    margin: 1rem auto 0;
  }

  .desc {
    width: 100%;
    text-align: center;
  }

  .description {
    letter-spacing: 1px;
    line-height: 1.6;
    font-weight: 400;
    color: #e0e0e0;
    font-size: 16px;
    line-height: 1.5;
    max-width: 100%;
    padding: 0 10px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
    width: 100%;
  }

  .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
  }

  .feature:last-child {
    display: none; /* Hide the 6th feature on desktop */
  }

  .icon-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    box-shadow: 0 5px 15px rgba(231, 201, 128, 0.3);
    transition: all 0.3s ease;
  }

  .icon-circle i {
    font-size: 1.5rem;
    color: #000;
    transition: all 0.3s ease;
  }

  .feature:hover .icon-circle {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(231, 201, 128, 0.4);
  }

  .feature:hover .icon-circle i {
    transform: scale(1.1);
  }

  .feature-text {
    text-align: center;
  }

  .feature-text h3 {
    font-size: 1rem;
    margin: 0;
    color: #e7c980;
    font-weight: 600;
  }

  .feature-text p {
    font-size: 1rem;
    color: #999;
    margin: 0.1rem 0 0 0;
  }

  .book-now {
    display: inline-block;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    color: #000;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }

  .book-now:hover {
    background-color: #c4a032;
    transform: translateY(-2px);
  }

  /* Increase video-container size and fill the frame */
  .video-container {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16/9;
    background-color: #111;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.2);
    position: relative;
    margin: 2rem auto;
  }

  .video-container iframe {
    display: block; /* Remove inline spacing */
    border: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1200px) {
    .container {
      width: 95%;
    }
    h2 {
      font-size: 2.2rem;
    }
  }

  @media (max-width: 1024px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .content {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }
    .title-section {
      text-align: center;
    }
    .underline {
      margin-left: auto;
    }
    .features {
      max-width: 600px;
      margin: 0 auto 2rem auto;
    }
    .icon-circle {
      width: 55px;
      height: 55px;
    }
    .heading {
      font-size: 2rem;
    }
  }

  @media (max-width: 768px) {
    .luxury-experience {
      padding: 3rem 0;
    }
    h2 {
      font-size: 2.2rem;
    }
    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, auto);
      gap: 1.5rem;
      padding: 0;
      overflow-x: visible;
      width: 100%;
      max-width: 500px;
      margin: 0 auto 2rem auto;
    }
    .feature {
      width: auto;
      display: flex;
    }
    .feature:last-child {
      display: flex;
    }
    .icon-circle {
      width: 45px;
      height: 45px;
    }
    .heading {
      font-size: 1.5rem;
      white-space: normal;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .container {
      width: 100%;
    }
    .luxury-experience {
      padding: 2.8rem 0;
    }
    .features {
      gap: 1rem;
    }
    .icon-circle {
      width: 40px;
      height: 40px;
    }
    .feature-text h3 {
      font-size: 0.8rem;
    }
    .feature-text p {
      font-size: 0.7rem;
    }
    .heading {
      font-size: 1.5rem;
      white-space: normal;
      text-align: center;
    }
</style>

