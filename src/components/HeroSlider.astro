---
import { Image } from "astro:assets";
import SliderImageMob from "../assets/banner/banner-mob-1.webp";
import SliderImageDesk from "../assets/banner/banner-desk-1.jpg";
import SliderImage2 from "../assets/banner/banner-2.jpg";
import SliderImage3 from "../assets/banner/banner-3.jpg";
import SliderImage5Desk from "../assets/banner/banner-5.webp";
import ChristmasDesktop from "../assets/christmas-new-year/desktop/christmas.png";
import ChristmasMobile from "../assets/christmas-new-year/mobile/christmas.png";
import NewYearDesktop from "../assets/christmas-new-year/desktop/new-year.png";
import NewYearMobile from "../assets/christmas-new-year/mobile/new-year.png";
import DryDayDesk from "../assets/dry-day/Desktop/dry-day.png";
import DryDayMobile from "../assets/dry-day/Mobile/dry-day.png";

const sliderImages = [
  {
    desktop: NewYearDesktop,
    mobile: NewYearMobile,
    alt: "New Year celebration",
    isResponsive: true,
  },
  {
    desktop: SliderImageDesk,
    mobile: SliderImageMob,
    alt: "Casino Entertainment",
    isResponsive: true,
  },
  {
    image: SliderImage2,
    alt: "Live Shows",
    isResponsive: false,
  },
  {
    image: SliderImage3,
    alt: "Casino Games",
    isResponsive: false,
  },
  {
    image: SliderImage5Desk,
    alt: "Casino Experience",
    isResponsive: false,
  },
];
---

<!-- ✅ Preload the LCP hero (slide 1 desktop/mobile) -->
<link
  rel="preload"
  as="image"
  href={SliderImageDesk.src}
  type="image/jpeg"
  media="(min-width:768px)"
/>
<link
  rel="preload"
  as="image"
  href={SliderImageMob.src}
  type="image/jpeg"
  media="(max-width:767px)"
/>

<section class="hero-section">
  <div class="hero-slider">
    <div class="slider-container">
      {
        sliderImages.map((slide, index) => (
          <div class="slide" data-index={index}>
            {slide.isResponsive ? (
              <picture>
                <source
                  srcset={slide.mobile.src}
                  media="(max-width: 767px)"
                  type="image/avif"
                />
                <Image
                  src={slide.desktop}
                  alt={slide.alt}
                  widths={[480, 768, 1200, 1600]}
                  formats={["avif", "webp"]}
                  sizes="(max-width: 768px) 100vw, 1600px"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="slider-image"
                  fetchpriority="high"
                />
              </picture>
            ) : (
              <Image
                src={slide.image}
                alt={slide.alt}
                widths={[480, 768, 1200, 1600]}
                formats={["avif", "webp"]}
                sizes="(max-width: 768px) 100vw, 1600px"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                class="slider-image"
              />
            )}
          </div>
        ))
      }

      <button class="slider-btn prev" aria-label="Previous slide">❮</button>
      <button class="slider-btn next" aria-label="Next slide">❯</button>

      <div class="slider-dots">
        {
          sliderImages.map((_, index) => (
            <button
              class="dot"
              data-index={index}
              aria-label={`Go to slide ${index + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Small client-side script for lazy-initializing non-visible slides
  document.addEventListener("DOMContentLoaded", () => {
    const slides = document.querySelectorAll(".slide img[loading='lazy']");
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.loading = "eager";
          io.unobserve(e.target);
        }
      });
    });
    slides.forEach((img) => io.observe(img));
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const slides = document.querySelectorAll<HTMLElement>(".slide");
    const dots = document.querySelectorAll<HTMLElement>(".dot");
    const prevBtn = document.querySelector<HTMLButtonElement>(".prev");
    const nextBtn = document.querySelector<HTMLButtonElement>(".next");

    let currentSlide = 0;
    const slideCount = slides.length;

    function updateSlider() {
      slides.forEach((slide, index) => {
        slide.style.transform = `translateX(${100 * (index - currentSlide)}%)`;
        slide.style.opacity = index === currentSlide ? "1" : "0";
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle("active", index === currentSlide);
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slideCount;
      updateSlider();
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + slideCount) % slideCount;
      updateSlider();
    }

    // Initialize slider
    updateSlider();

    // Event listeners
    prevBtn?.addEventListener("click", prevSlide);
    nextBtn?.addEventListener("click", nextSlide);

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        currentSlide = index;
        updateSlider();
      });
    });

    // Auto-advance slides every 5 seconds
    setInterval(nextSlide, 5000);
  });
</script>

<style>
  .slide-image-1 {
    object-position: right center;
    object-position: 85% center;
  }

  .hero-section {
    width: 100%;
    padding: 0 1rem;
    margin: 0;
    box-sizing: border-box;
    margin-top: 140px;
    position: relative;
    z-index: 1;
  }

  .hero-slider {
    position: relative;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    height: min(600px, 70vh);
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .slider-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transition: all 0.5s ease;
    opacity: 0;
  }

  .slide[data-index="0"] {
    opacity: 1;
  }

  .slider-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(212, 175, 55, 0.9);
    color: white;
    border: none;
    width: clamp(30px, 5vw, 40px);
    height: clamp(30px, 5vw, 40px);
    border-radius: 50%;
    cursor: pointer;
    font-size: clamp(0.8rem, 1.5vw, 1.2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .slider-btn:hover {
    background: rgb(212, 175, 55);
    transform: translateY(-50%) scale(1.1);
  }

  .prev {
    left: clamp(0.5rem, 2vw, 1rem);
  }

  .next {
    right: clamp(0.5rem, 2vw, 1rem);
  }

  .slider-dots {
    position: absolute;
    bottom: clamp(1rem, 2vh, 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: clamp(0.5rem, 1vw, 0.75rem);
    z-index: 2;
  }

  .dot {
    width: clamp(8px, 1.5vw, 10px);
    height: clamp(8px, 1.5vw, 10px);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    border: 2px solid rgba(212, 175, 55, 0.5);
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: rgb(212, 175, 55);
    border-color: white;
    transform: scale(1.2);
  }

  .desktop-image {
    display: block;
  }

  .mobile-image {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 0 0.5rem;
      margin-top: 170px;
      z-index: 1;
    }

    .hero-slider {
      height: min(400px, 60vh);
      border-radius: 4px;
    }

    .desktop-image {
      display: none;
    }

    .mobile-image {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      margin-top: 150px;
    }

    .hero-slider {
      height: min(500px, 50vh);
    }
  }
</style>
