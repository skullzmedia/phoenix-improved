    );
    background-size: 200% 100%;
    animation: goldShimmer 1.5s infinite linear;
    pointer-events: none;
  }

  /* Note styling */
  .vip-note {
    text-align: center;
    margin-top: 2rem;
    color: #ccc;
    font-style: italic;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: 0.6s;
    opacity: 0;
  }

  .gold-link {
    color: #e7c980;
    text-decoration: none;
    position: relative;
    transition: all 0.3s ease;
  }

  .gold-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    transition: width 0.3s ease;
  }

  .gold-link:hover {
    color: #fff;
  }

  .gold-link:hover::after {
    width: 100%;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .vip-table {
      font-size: 0.9rem;
    }

    .vip-table th,
    .vip-table td {
      padding: 1rem;
    }

    .buy-in {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    .vip-table {
      font-size: 0.8rem;
    }

    .vip-table th,
    .vip-table td {
      padding: 0.8rem 0.5rem;
    }

    .buy-in {
      font-size: 1rem;
    }
  }

  /* Add these styles to your existing styles */
  .vip-cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #d4af37 0%, #f2c75e 50%, #ce9639 100%);
    color: #000;
    font-size: 1.125rem;
    font-weight: 700;
    padding: 1.25rem 3rem;
    border-radius: 50px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
  }

  .cta-button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    transition: left 0.5s;
  }

  .cta-button:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    background: linear-gradient(135deg, #ce9639 0%, #d4af37 50%, #f2c75e 100%);
  }

  .cta-button:hover::before {
    left: 100%;
  }

  .cta-button:active {
    transform: translateY(-1px) scale(1.02);
  }

  .cta-button .arrow {
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    font-weight: bold;
  }

  .cta-button:hover .arrow {
    transform: translateX(8px) scale(1.1);
  }

  @media (max-width: 768px) {
    .vip-cta {
      margin-top: 2rem;
    }

    .cta-button {
      font-size: 1rem;
      padding: 0.875rem 2rem;
    }
  }

  @media (max-width: 480px) {
    .vip-cta {
      margin-top: 1.5rem;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
      font-size: 0.9375rem;
      padding: 0.75rem 1.5rem;
    }
  }
</style>

<script>
  // Wait for DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", () => {
    // Update the packagesData array to include day package
    const packagesData = [
      {
        name: "Regular",
        alcoholBrands: {
          Whiskey: "Blenders, Signature, Rockford",
          Vodka: "Romanov",
          Rum: "Old Monk, Cabo",
          Brandy: "Honey Bee, Mansion House",
          Beer: "Kingfisher",
          Feni: "Coconut/Cashew",
        },
      },
      {
        name: "Premium",
        alcoholBrands: {
          Whiskey:
            "Vat 69, Black Dog, Oak Smith Gold, 100 Pipers, Red Label & Ballantines",
          Vodka: "Smirnoff Regular",
          Rum: "Old Monk, Cabo",
          Gin: "Greater than",
          Brandy: "Honey Bee, Mansion House, Morpheus xo",
          Beer: "Kingfisher, Kingfisher ultra, Budweiser",
          Feni: "Coconut/Cashew",
          Breezer: "",
          Wine: "Amora White/Amora Red/",
          "Energy Drink": "As per stock available",
          Liqueur: "Kahlua, Triple sec",
        },
      },
      {
        name: "Elite",
        alcoholBrands: {
          Whiskey: "Chivas Regal 12 yrs, Singleton 12 yrs, Glenfiddich 12 yrs",
          Vodka: "Ciroc & Ketel One",
          Rum: "Old Monk, Coconut Rum",
          Gin: "Blue Riband, Gordons & Bombay Sapphire",
          Brandy: "Honey Bee, Mansion House, Morpheus xo",
          Beer: "House Brands + Premium & Heineken",
          Feni: "Coconut/Cashew",
          Breezer: "",
          Wine: "Yellow tail and Jacob Greek",
          "Energy Drink": "Red Bull",
          Liqueur: "Kahlua, Triple sec & Baileys",
          "Sparkling Wine": "Frizzano/Zampa Brut",
        },
      },
    ];

    // Elements
    const popup = document.getElementById("alcoholPopup");
    const closeBtn = document.getElementById("closePopupBtn");
    const packageNameEl = document.getElementById("packageTypeName");
    const brandsListEl = document.getElementById("alcoholBrandsList");

    // Update the click handler in setupAlcoholButtons
    const setupAlcoholButtons = () => {
      const alcoholButtons = document.querySelectorAll(".alcohol-btn");

      alcoholButtons.forEach((button) => {
        button.addEventListener("click", function (e) {
          e.preventDefault();
          let packageIndex = parseInt(this.dataset.package) || 0;
          let packageName = packagesData[packageIndex].name;

          // Check if this is the day package button
          if (this.dataset.package === "day") {
            packageIndex = 0; // Use Regular package's alcohol list
            packageName = "Day"; // But change the name
          }

          // Set package name
          if (packageNameEl)
            packageNameEl.textContent = packageName + " Package";

          // Clear previous content
          if (brandsListEl) brandsListEl.innerHTML = "";

          // Add alcohol brands
          const brands = packagesData[packageIndex].alcoholBrands;
          for (const category in brands) {
            const brandsText = brands[category];

            // Skip if no brands
            if (!brandsText && brandsText !== "") continue;

            // Create category container
            const categoryEl = document.createElement("div");
            categoryEl.className = "alcohol-category";

            // Add title
            const titleEl = document.createElement("h4");
            titleEl.className = "alcohol-category-title";
            titleEl.textContent = category;
            categoryEl.appendChild(titleEl);

            // Handle brands
            if (brandsText.trim() === "") {
              // Empty category
              const emptyEl = document.createElement("div");
              emptyEl.className = "no-brands";
              emptyEl.textContent = "Available upon request";
              categoryEl.appendChild(emptyEl);
            } else {
              // Create brands list
              const listEl = document.createElement("ul");
              listEl.className = "brand-list";

              // Add each brand
              const brandArray = brandsText.split(",");
              brandArray.forEach((brand) => {
                const brandName = brand.trim();
                if (brandName) {
                  const itemEl = document.createElement("li");
                  itemEl.className = "brand-item";
                  itemEl.textContent = brandName;
                  listEl.appendChild(itemEl);
                }
              });

              categoryEl.appendChild(listEl);
            }

            if (brandsListEl) brandsListEl.appendChild(categoryEl);
          }

          // Show popup
          if (popup) {
            popup.classList.add("active");
            document.body.style.overflow = "hidden";
          }
        });
      });
    };

    // Setup close button
    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        if (popup) {
          popup.classList.remove("active");
          document.body.style.overflow = "";
        }
      });
    }

    // Close on backdrop click
    if (popup) {
      popup.addEventListener("click", (e) => {
        if (
          e.target === popup ||
          (e.target as HTMLElement)?.classList?.contains(
            "alcohol-popup-backdrop"
          )
        ) {
          popup.classList.remove("active");
          document.body.style.overflow = "";
        }
      });
    }

    // Close on ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && popup && popup.classList.contains("active")) {
        popup.classList.remove("active");
        document.body.style.overflow = "";
      }
    });

    // Initialize
    setupAlcoholButtons();

    // Re-initialize on potential dynamic content changes
    const observer = new MutationObserver(function (mutations) {
      setupAlcoholButtons();
    });

    // Start observing the document body for changes
    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });

    // Tab switching functionality
    const policyTabs =
      document.querySelectorAll<HTMLButtonElement>(".policy-tab");
    const policyContents =
      document.querySelectorAll<HTMLDivElement>(".policy-content");

    policyTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        // Remove active class from all tabs and contents
        policyTabs.forEach((t) => t.classList.remove("active"));
        policyContents.forEach((c) => c.classList.remove("active"));

        // Add active class to clicked tab
        tab.classList.add("active");

        // Get the tab data attribute
        const tabId = tab.getAttribute("data-tab");

        // Activate corresponding content
        const content = document.getElementById(
          `${tabId}-content`
        ) as HTMLDivElement | null;
        if (content) {
          content.classList.add("active");
        }
      });
    });

    // Package tab switching
    const packageButtons =
      document.querySelectorAll<HTMLButtonElement>(".package-button");
    const packageImages = document.querySelectorAll<HTMLImageElement>(
      ".packages-image img"
    );
    const packageDetails =
      document.querySelectorAll<HTMLDivElement>(".package-details");

    packageButtons.forEach((button) => {
      button.addEventListener("click", () => {
        // Remove active class from all buttons and images
        packageButtons.forEach((btn) => btn.classList.remove("active"));
        packageImages.forEach((img) => img.classList.remove("active"));
        packageDetails.forEach((detail) => detail.classList.remove("active"));

        // Add active class to clicked button and corresponding image
        button.classList.add("active");

        const targetId = button.getAttribute("data-target");
        const targetImage = document.getElementById(
          `${targetId}-image`
        ) as HTMLImageElement | null;
        const targetDetail = document.getElementById(
          `${targetId}-details`
        ) as HTMLDivElement | null;

        if (targetImage) targetImage.classList.add("active");
        if (targetDetail) targetDetail.classList.add("active");
      });
    });
  });
</script>
