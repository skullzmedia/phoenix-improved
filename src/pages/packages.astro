---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import regularPackageImg from "../assets/packages/1.jpg";
import premiumPackageImg from "../assets/packages/2.jpg";
import elitePackageImg from "../assets/packages/3.jpg";
import {
  Circle,
  Dices,
  Martini,
  Music,
  PartyPopper,
  Utensils,
  Wine,
} from "lucide-astro";

const pageTitle =
  "Goa Casino Packages – Best Casino in Panjim | Phoenix Casino";
const pageDescription =
  "Choose from Regular, Premium & Elite casino packages at Phoenix Casino Goa. Enjoy complimentary drinks, unlimited buffet & thrilling casino games in Panjim.";

// Updated packages data with alcohol brands information
const packages = [
  {
    id: "regular",
    letter: "R",
    name: "Regular Package",
    pricing: {
      stag: { price: "2,000", otpc: "1,000" },
      couple: { price: "3,000", otpc: "2,500" },
    },
    features: [
      { icon: Utensils, text: "Starters" },
      { icon: Utensils, text: "Unlimited Buffet" },
      { icon: Music, text: "Live Entertainment & Performances" },
      {
        icon: PartyPopper,
        text: "Alcoholic Drinks - 2 Coupons per head: 30ml each",
        note: "* T&C Apply",
        alcoholBrands: {
          Whiskey: "Blenders, Signature, Rockford",
          Vodka: "Romanov",
          Rum: "Old Monk, Cabo",
          Gin: "Blue Riband",
          Brandy: "Honey Bee, Mansion House",
          Beer: "Kingfisher",
          Feni: "Big Boss Coconut/Cashew",
        },
      },
    ],
  },
  {
    id: "premium",
    letter: "P",
    name: "Premium Package",
    pricing: {
      stag: { price: "3,000", otpc: "2,000" },
      couple: { price: "5,000", otpc: "4,000" },
    },
    features: [
      { icon: Utensils, text: "Starters" },
      { icon: Utensils, text: "Unlimited Buffet" },
      { icon: Music, text: "Live Entertainment & Performances" },
      {
        icon: PartyPopper,
        text: "Alcoholic Drinks - 2 Coupons per head: 30ml each",
        note: "* T&C Apply",
        alcoholBrands: {
          Whiskey:
            "Vat 69, Black Dog, Oak Smith Gold, 100 Pipers, Black & White, Red Label & Ballantines",
          Vodka: "Smirnoff Regular",
          Rum: "Old Monk, Bacardi white/Black, Cabo",
          Gin: "Blue Riband, Greater than",
          Brandy: "Honey Bee, Mansion House, Morpheus xo",
          Beer: "Kingfisher, Kingfisher ultra, Budweiser",
          Feni: "Big Boss Coconut/Cashew",
          Breezer: "",
          Wine: "Amora White/Amora Red/Langoor Red & Port wine",
          Vermouth: "Martini, Campari",
          "Energy Drink": "As per stock available",
          Liqueur: "Kahlua, Triple sec",
        },
      },
    ],
  },
  {
    id: "elite",
    letter: "E",
    name: "Elite Package",
    pricing: {
      stag: { price: "7,000", otpc: "7,000" },
      couple: { price: "10,000", otpc: "10,000" },
    },
    features: [
      { icon: Utensils, text: "Starters" },
      { icon: Utensils, text: "Unlimited Buffet" },
      { icon: Music, text: "Live Entertainment & Performances" },
      {
        icon: PartyPopper,
        text: "Alcoholic Drinks - 2 Coupons per head: 30ml each",
        note: "* T&C Apply",
        alcoholBrands: {
          Whiskey:
            "Black Label, Chivas Regal 12 yrs, Singleton 12 yrs, Glenfiddich 12 yrs",
          Vodka: "Absolut, Ciroc & Ketel One",
          Rum: "Old Monk, Bacardi white/Black, Cabo, Coconut Rum",
          Gin: "Blue Riband, Gordons & Bombay Sapphire",
          Brandy: "Honey Bee, Mansion House, Morpheus xo",
          Beer: "House Brands + Premium & Heineken",
          Feni: "Coconut/Cashew",
          Breezer: "",
          Cognac: "St. Remy VSOP",
          Wine: "Yellow tail and Jacob Greek",
          Vermouth: "Martini, Campari",
          "Energy Drink": "Red Bull",
          Liqueur: "Kahlua, Triple sec & Baileys",
          "Sparkling Wine": "Frizzano/Zampa Brut",
        },
      },
    ],
  },
];

// Group packages information
const groupDiscounts = [
  {
    text: "10% discount or extra 500 OTPC per group- 15+ Pax",
  },
];

// Highlights information
const highlights = [
  {
    icon: Martini,
    title: "Food & Drinks",
    description: "Enjoy premium gourmet dishes and specialty cocktails",
  },
  {
    icon: Dices,
    title: "Games",
    description: "Experience the thrill of our casino games and slot machines",
  },
  {
    icon: Music,
    title: "Entertainment",
    description: "Live shows, performances, and exciting events",
  },
];
---

<Layout
  title="Packages | Phoenixx Casino"
  description="Choose from Regular, Premium & Elite casino packages at Phoenix Casino Goa. Enjoy complimentary drinks, unlimited buffet & thrilling casino games in Panjim."
>
  <section class="page-banner">
    <div class="container">
      <h1 class="page-title">ENTRY PACKAGES</h1>
      <p class="page-subtitle">
        Experience luxury with our exclusive casino packages
      </p>
    </div>
  </section>

  <!-- Individual Packages Section with fixed labels -->
  <section class="packages-section" id="entry-packages">
    <div class="container">
      <div class="packages-grid">
        {
          packages.map((pkg, packageIndex) => (
            <div class="package-card">
              <div class="package-letter">{pkg.letter}</div>
              <h3 class="package-name">{pkg.name}</h3>

              <div class="package-pricing">
                <div class="price-item">
                  Stag: ₹{pkg.pricing.stag.price} (With ₹{pkg.pricing.stag.otpc}{" "}
                  OTPC)
                </div>
                {pkg.id !== "regular" && (
                  <div class="price-item">
                    Couple: ₹{pkg.pricing.couple.price} (With ₹
                    {pkg.pricing.couple.otpc} OTPC)
                  </div>
                )}
              </div>

              <ul class="package-features">
                {pkg.features.map((feature, featureIndex) => (
                  <li class="feature-item">
                    <div class="feature-icon">
                      <feature.icon size={20} color="#e7c980" />
                    </div>
                    <div class="feature-content">
                      {feature.alcoholBrands ? (
                        <button
                          class="alcohol-btn"
                          data-package={packageIndex}
                          data-feature={featureIndex}
                        >
                          <span class="feature-text">{feature.text}</span>
                          <Wine size={16} color="#e7c980" class="ml-1" />
                        </button>
                      ) : (
                        <span class="feature-text">{feature.text}</span>
                      )}
                      {feature.note && (
                        <span class="feature-note">{feature.note}</span>
                      )}
                    </div>
                  </li>
                ))}
              </ul>

              <a href="/contact" class="book-btn">
                Book Now
              </a>
            </div>
          ))
        }
      </div>
      <div class="packages-note">
        <p>
          Entry for children below 5 years - FREE | Entry for Children 6-20
          years - ₹500 INR
        </p>
      </div>
    </div>
  </section>

  <!-- Improved Alcohol Brands Popup -->
  <div id="alcoholPopup" class="alcohol-popup">
    <div class="alcohol-popup-backdrop"></div>
    <div class="alcohol-popup-content">
      <button id="closePopupBtn" class="close-popup">&times;</button>
      <h2 class="popup-title">Available Alcoholic Brands</h2>

      <div class="package-type-label">Package Type</div>
      <div id="packageTypeName" class="package-type-name">Elite Package</div>
      <div class="popup-divider"></div>

      <div id="alcoholBrandsList" class="alcohol-brands-list">
        <!-- Content will be added here via JavaScript -->
      </div>
    </div>
  </div>

  <!-- Group Discounts Section -->
  <section class="group-discounts-section" id="group-discounts">
    <div class="container">
      <h2 class="section-title">Group Discounts</h2>

      <div class="discounts-container">
        <ul class="discount-list">
          {
            groupDiscounts.map((discount) => (
              <li>
                <Circle size={8} color="#e7c980" class="dot-icon" />
                <span>{discount.text}</span>
              </li>
            ))
          }
        </ul>

        <a href="/contact" class="book-btn wide-btn">Book Now</a>
      </div>
    </div>
  </section>

  <!-- Day Pass Section
  <section class="day-pass-section" id="day-pass">
    <div class="container">
      <h2 class="section-title">DAY PACKAGE</h2>

      <div style="display: flex; justify-content: center;">
        <div class="package-card" style="max-width: 350px; width: 100%;">
          <div class="package-letter">D</div>
          <h3 class="package-name">Day Package</h3>

          <div class="package-pricing">
            <div class="price-item">₹1000 <span>/person</span></div>
          </div>

          <ul class="package-features">
            <li class="feature-item">
              <div class="feature-icon">
                <i class="fas fa-ticket-alt"></i>
              </div>
              <div class="feature-content">
                <span class="feature-text"
                  >Entry Charges - Rs 1000 / head (No OTPC applicable)</span
                >
              </div>
            </li>
            <li class="feature-item">
              <div class="feature-icon">
                <i class="fas fa-clock"></i>
              </div>
              <div class="feature-content">
                <span class="feature-text">Timing: 9AM to 4PM</span>
              </div>
            </li>
            <li class="feature-item">
              <div class="feature-icon">
                <i class="fas fa-utensils"></i>
              </div>
              <div class="feature-content">
                <span class="feature-text">Starters</span>
              </div>
            </li>
            <li class="feature-item">
              <div class="feature-icon">
                <i class="fas fa-utensils"></i>
              </div>
              <div class="feature-content">
                <span class="feature-text">Unlimited Buffet</span>
              </div>
            </li>
            <li class="feature-item">
              <div class="feature-icon">
                <i class="fas fa-glass-cheers"></i>
              </div>
              <div class="feature-content">
                <button class="alcohol-btn" data-package="day">
                  <span class="feature-text"
                    >Alcoholic Drinks - 2 Coupons per head: 30ml each</span
                  >
                  <i class="fas fa-wine-glass-alt alcohol-icon ml-1"></i>
                </button>
                <span class="feature-note"
                  ><a class="tc-link" data-tab="tc">*T&C Apply</a></span
                >
              </div>
            </li>
          </ul>

          <a href="/contact" class="book-btn">Book Now</a>
        </div>
      </div>
    </div>
  </section> -->

  <!-- VIP Packages Section -->
  <section class="vip-packages-section" id="vip-packages">
    <div class="container">
      <h2 class="section-title">CORPORATE PACKAGES</h2>

      <!-- VIP Images Section -->
      <div class="vip-images-section">
        <!-- Desktop Image -->
        <div class="vip-image-desktop">
          <Image
            src={import("../assets/vip-section/vip-desktop.jpeg")}
            alt="VIP Experience - Desktop"
            width={1200}
            height={600}
          />
        </div>
        <!-- Mobile Image -->
        <div class="vip-image-mobile">
          <Image
            src={import("../assets/vip-section/vip-mob.jpeg")}
            alt="VIP Experience - Mobile"
            width={600}
            height={800}
          />
        </div>
      </div>

      <div class="vip-cta">
        <a href="/contact" class="cta-button">
          Contact Us
          <span class="arrow">→</span>
        </a>
        <a
          href="https://wa.me/919960007937?text=Hi%20I%20am%20interested%20in%20VIP%20Packages%20at%20Phoenix%20Casino%20Goa"
          class="cta-button whatsapp-btn"
          target="_blank"
          rel="noopener"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 640 640"
            fill="white"
            stroke="white"
            class="whatsapp-icon"
          >
            <path
              d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1L319.9 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1zM319.9 502.7C286.7 502.7 254.2 493.8 225.9 477L219.2 473L149.4 491.3L168 423.2L163.6 416.2C145.1 386.8 135.4 352.9 135.4 318C135.4 216.3 218.2 133.5 320 133.5C369.3 133.5 415.6 152.7 450.4 187.6C485.2 222.5 506.6 268.8 506.5 318.1C506.5 419.9 421.6 502.7 319.9 502.7zM421.1 364.5C415.6 361.7 388.3 348.3 383.2 346.5C378.1 344.6 374.4 343.7 370.7 349.3C367 354.9 356.4 367.3 353.1 371.1C349.9 374.8 346.6 375.3 341.1 372.5C308.5 356.2 287.1 343.4 265.6 306.5C259.9 296.7 271.3 297.4 281.9 276.2C283.7 272.5 282.8 269.3 281.4 266.5C280 263.7 268.9 236.4 264.3 225.3C259.8 214.5 255.2 216 251.8 215.8C248.6 215.6 244.9 215.6 241.2 215.6C237.5 215.6 231.5 217 226.4 222.5C221.3 228.1 207 241.5 207 268.8C207 296.1 226.9 322.5 229.6 326.2C232.4 329.9 268.7 385.9 324.4 410C359.6 425.2 373.4 426.5 391 423.9C401.7 422.3 423.8 410.5 428.4 397.5C433 384.5 433 373.4 431.6 371.1C430.3 368.6 426.6 367.2 421.1 364.5z"
            ></path>
          </svg>
          WhatsApp Us
        </a>
      </div>
      <style>
        .whatsapp-icon {
          width: 20px;
          height: 20px;
        }

        .vip-cta {
          display: flex;
          align-items: center;
          justify-content: center;
          margin-top: 1.5rem;
        }
        .vip-cta .cta-button.whatsapp-btn {
          margin-left: 1rem;
          display: inline-flex;
          align-items: center;
          background: linear-gradient(
            135deg,
            #25d366 0%,
            #128c7e 50%,
            #075e54 100%
          );
          color: white;
          border: 2px solid #25d366;
        }

        .vip-cta .cta-button.whatsapp-btn:hover {
          background: linear-gradient(
            135deg,
            #128c7e 0%,
            #25d366 50%,
            #075e54 100%
          );
          box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4);
        }
        @media (max-width: 768px) {
          .vip-cta {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
          }
          .vip-cta .cta-button.whatsapp-btn {
            margin-left: 0;
            width: 100%;
            justify-content: center;
          }
          .vip-cta .cta-button {
            width: 100%;
            justify-content: center;
          }
        }
      </style>
    </div>
  </section>
  <style>
    .vip-image-desktop {
      display: block;
    }
    .vip-image-mobile {
      display: none;
    }
    @media (max-width: 768px) {
      .vip-image-desktop {
        display: none;
      }
      .vip-image-mobile {
        display: block;
      }
    }
    .vip-images-section img {
      width: 100%;
      height: auto;
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }
  </style>

  <!-- Highlights Section -->
  <section class="highlights-section">
    <div class="container">
      <h2 class="section-title">HIGHLIGHTS</h2>

      <div class="highlights-grid">
        {
          highlights.map((highlight) => (
            <div class="highlight-card">
              <div class="highlight-icon">
                <highlight.icon size={42} color="#e7c980" />
              </div>
              <h3 class="highlight-title">{highlight.title}</h3>
              <p class="highlight-desc">{highlight.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Policy Tabs Section -->
  <section class="policy-section">
    <div class="container">
      <h2 class="section-title">POLICIES & INFORMATION</h2>

      <div class="policy-tabs-container">
        <div class="policy-tabs">
          <button class="policy-tab active" data-tab="tc">T&C</button>
          <button class="policy-tab" data-tab="otpc">OTPC</button>
          <button class="policy-tab" data-tab="general">General</button>
        </div>

        <div class="policy-content-container">
          <!-- T&C Tab Content -->
          <div class="policy-content active" id="tc-content">
            <h3 class="policy-title">Terms & Conditions</h3>
            <div class="policy-text">
              <ul class="policy-list">
                <li>
                  All bookings made through the Call Centre and Website are
                  non-refundable
                </li>
                <li>
                  Rescheduling or cancellation is not allowed within 24 hours of
                  the scheduled date of visit
                </li>
                <li>
                  One-time date change is allowed to reschedule the visit for a
                  future date with an applicable difference amount payable
                  depending on the pricing at the time of revision. Request to
                  be placed 24 hours ahead of the scheduled date of visit
                </li>
                <li>
                  If the pricing for the revised booking is of a lesser amount
                  than your original booking, the remainder is not payable to
                  Guest
                </li>
                <li>
                  Cancellation due to valid medical emergencies is subject to a
                  full refund. However, the same will be addressed post
                  verification of submitted documents
                </li>
                <li>
                  No cancellations/refunds are allowed for bookings made for
                  blackout dates or at special rates
                </li>
                <li>
                  No cancellations/refunds or transfer of tickets in case of no
                  show or unutilized bookings
                </li>
                <li>
                  Refunds shall be issued to the payment method used for the
                  purchase of original tickets/packages. Once refund request is
                  generated, the same will be processed within 10 working days
                </li>
                <li>
                  No refund can be processed if a guest utilizes the playing
                  coupons offered to them as part of their package
                </li>
                <li>
                  Refund & Cancellation policy is subject to change without
                  notice.
                </li>
                <li>Management's decision shall remain final.</li>
              </ul>
            </div>
          </div>

          <!-- OTPC Tab Content -->
          <div class="policy-content" id="otpc-content">
            <h3 class="policy-title">OTPC</h3>
            <div class="policy-text">
              <ul class="policy-list">
                <li>Roulette Table - Even Chances only.</li>
                <li>Baccarat - Only Primary bet (player) & no optional bet</li>
                <li>Andar Bahar - only andar</li>
                <li>
                  Blackjack - Only primary bets no insurance & no surrender
                </li>
                <li>OTPC cannot be encashed</li>
                <li>
                  OTPC cannot be played on the slot machines/evona/indian flush
                </li>
                <li>
                  OTPC can only be played once regardless of the outcome of the
                  game it will be retained by the dealer
                </li>
                <li>
                  OTPC are in denominations of 500 & cannot be broken down to
                  lower denominations
                </li>
                <li>Management decision is final</li>
              </ul>
            </div>
          </div>

          <!-- General Tab Content -->
          <div class="policy-content" id="general-content">
            <h3 class="policy-title">General Information</h3>
            <div class="policy-text">
              <ul class="policy-list">
                <li>Dress Code: Smart Casuals</li>
                <li>Carry Govt ID</li>
                <li>Entry age 21+</li>
                <li>Entry valid till 06:00 am</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Page Banner */
  .page-banner {
    padding: 8rem 0 2rem;
    background-color: #000;
    background-size: cover;
    background-position: center;
    text-align: center;
    position: relative;
  }

  .page-banner::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .page-banner .container {
    position: relative;
    z-index: 2;
  }

  .page-title {
    font-size: 3.5rem;
    color: #e7c980;
    margin-bottom: 1rem;
    text-transform: uppercase;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: #fff;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Common Styles */
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 3rem;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Children Entry Note */
  .packages-note {
    text-align: center;
    margin-top: 2rem;
    color: #e7c980;
    font-size: 1.1rem;
    font-weight: 500;
    padding: 1.25rem;
    background: rgba(231, 201, 128, 0.05);
    border: 1px dashed rgba(231, 201, 128, 0.3);
    border-radius: 8px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Packages Section */
  .packages-section {
    padding: 3rem 0;
    background-color: #000;
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .package-card {
    border: 1px solid rgba(231, 201, 128, 0.3);
    border-radius: 8px;
    padding: 2.5rem 2rem;
    background-color: rgba(20, 20, 20, 0.5);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .package-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(231, 201, 128, 0.1);
    border-color: rgba(231, 201, 128, 0.5);
  }

  .package-letter {
    font-size: 5rem;
    color: #e7c980;
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    line-height: 1;
    transition: all 0.3s ease;
  }

  .package-name {
    text-align: center;
    font-size: 1.5rem;
    color: #e7c980;
    margin-bottom: 2rem;
    font-weight: 400;
    text-transform: lowercase;
  }

  .package-pricing {
    margin-bottom: 1.5rem;
  }

  .price-item {
    color: #fff;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .package-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }

  .package-features li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: #ccc;
  }

  .package-features i {
    color: #e7c980;
    font-size: 1rem;
  }

  .feature-note {
    display: block;
    margin-top: 0.3rem;
    color: #e7c980;
    font-size: 0.85rem;
  }

  .book-btn {
    display: inline-block;
    background-color: #e7c980;
    color: #000;
    text-align: center;
    padding: 1rem;
    border-radius: 4px;
    font-weight: 600;
