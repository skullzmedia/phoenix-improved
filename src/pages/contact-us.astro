    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 2.5rem;
    font-weight: 600;
  }

  .contact-details {
    margin-bottom: 2.5rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .contact-icon {
    width: 40px;
    height: 40px;
