---
import Layout from "../layouts/Layout.astro";
import {
  ArrowRight,
  Facebook,
  Instagram,
  Mail,
  MapPin,
  MessageSquare,
  Phone,
  User,
} from "lucide-astro";

// Contact information
const contactInfo = {
  address: "Hilton Goa Resort, Saipem, Candolim",
  primaryPhones: ["For Bookings Call:", "+919960007937", "+919960010198"],
  additionalPhones: [
    { label: "For Vacancy Call", number: "9960006687" },
  ],
  email: "marketing@phoenixcasino.in",
};
---

<Layout title="Contact Us | Phoenixx Casino">
  <section class="page-banner">
    <div class="container">
      <h1 class="page-title">Contact Us</h1>
      <p class="page-subtitle">
        Get in touch with our team for bookings and inquiries
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-container">
        <div class="contact-info">
          <h2 class="contact-heading">CONTACT US</h2>
          <h3 class="contact-subheading">Have Questions? Get in touch!</h3>

          <div class="contact-details">
            <div class="contact-item">
              <div class="contact-icon">
                <MapPin size={16} color="#e7c980" />
              </div>
              <div class="contact-text">
                {contactInfo.address}
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <Phone size={16} color="#e7c980" />
              </div>
              <div class="contact-text">
                <span class="booking-label">For Bookings Call:</span>
                {
                  contactInfo.primaryPhones.slice(1).map((phone, idx) => (
                    <>
                      <a href={`tel:${phone}`}>{phone}</a>
                      {idx < contactInfo.primaryPhones.slice(1).length - 1 && (
                        <span style="margin: 0 0.5em;">/</span>
                      )}
                    </>
                  ))
                }
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <Phone size={16} color="#e7c980" />
              </div>
              <div class="contact-text">
                {
                  contactInfo.additionalPhones.map((phone) => (
                    <div class="additional-phone-item">
                      <span style="color: #e7c980; opacity: 0.9; margin-right: 0.5rem;">
                        {phone.label}:
                      </span>
                      <a href={`tel:+91${phone.number}`}>{phone.number}</a>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <Mail size={16} color="#e7c980" />
              </div>
              <div class="contact-text">
                <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a>
              </div>
            </div>
          </div>

          <div class="business-hours">
            <h4 class="hours-heading">Business Hours</h4>
            <p class="hours-text">Open 24 hours</p>
            <p class="hours-note">Entry valid till 06:00 am</p>
          </div>

          <div class="social-links">
            <a href="#" class="social-link" aria-label="Facebook">
              <Facebook size={16} color="#e7c980" />
            </a>
            <a href="#" class="social-link" aria-label="Instagram">
              <Instagram size={16} color="#e7c980" />
            </a>
            <a href="#" class="social-link" aria-label="WhatsApp">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 640 640"
                fill="#e7c980"
                class="whatsapp-icon"
              >
                <path
                  d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1L319.9 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1zM319.9 502.7C286.7 502.7 254.2 493.8 225.9 477L219.2 473L149.4 491.3L168 423.2L163.6 416.2C145.1 386.8 135.4 352.9 135.4 318C135.4 216.3 218.2 133.5 320 133.5C369.3 133.5 415.6 152.7 450.4 187.6C485.2 222.5 506.6 268.8 506.5 318.1C506.5 419.9 421.6 502.7 319.9 502.7zM421.1 364.5C415.6 361.7 388.3 348.3 383.2 346.5C378.1 344.6 374.4 343.7 370.7 349.3C367 354.9 356.4 367.3 353.1 371.1C349.9 374.8 346.6 375.3 341.1 372.5C308.5 356.2 287.1 343.4 265.6 306.5C259.9 296.7 271.3 297.4 281.9 276.2C283.7 272.5 282.8 269.3 281.4 266.5C280 263.7 268.9 236.4 264.3 225.3C259.8 214.5 255.2 216 251.8 215.8C248.6 215.6 244.9 215.6 241.2 215.6C237.5 215.6 231.5 217 226.4 222.5C221.3 228.1 207 241.5 207 268.8C207 296.1 226.9 322.5 229.6 326.2C232.4 329.9 268.7 385.9 324.4 410C359.6 425.2 373.4 426.5 391 423.9C401.7 422.3 423.8 410.5 428.4 397.5C433 384.5 433 373.4 431.6 371.1C430.3 368.6 426.6 367.2 421.1 364.5z"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="contact-form-container">
          <form id="contactForm" class="contact-form">
            <div class="form-field">
              <label for="name" class="field-icon">
                <User size={16} color="#e7c980" />
              </label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Name"
                required
              />
            </div>

            <div class="form-field">
              <label for="phone" class="field-icon">
                <Phone size={16} color="#e7c980" />
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="Phone Number"
                required
              />
            </div>

            <div class="form-field">
              <label for="email" class="field-icon">
                <Mail size={16} color="#e7c980" />
              </label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Email"
                required
              />
            </div>

            <div class="form-field">
              <label for="message" class="field-icon">
                <MessageSquare size={16} color="#e7c980" />
              </label>
              <textarea
                id="message"
                name="message"
                placeholder="Your Message"
                required
                rows="4"></textarea>
            </div>

            <button type="submit" class="submit-btn">
              Send WhatsApp Message
              <ArrowRight size={16} color="#000" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="map-section">
    <div class="map-container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3845.5664728872505!2d73.7595423!3d15.5160693!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bbfc09c4be97b3f%3A0x89f9da2c01a9e2f9!2sHilton%20Goa%20Resort!5e0!3m2!1sen!2sin!4v1649252930000!5m2!1sen!2sin"
        width="100%"
        height="500"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Layout>

<style>
  .whatsapp-icon {
    width: 20px;
    height: 20px;
    color: #e7c980;
  }

  /* Page Banner - adjusted to match nav */
  .page-banner {
    padding: 3rem 0 4rem;
    background-color: #000;
    background-size: cover;
    background-position: center;
    text-align: center;
    position: relative;
    margin-top: 120px; /* Account for fixed nav height */
  }

  .page-banner::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .page-banner .container {
    position: relative;
    z-index: 2;
  }

  .page-title {
    font-size: 3rem;
    color: #e7c980;
    margin-bottom: 1rem;
    text-transform: uppercase;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: #fff;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Common Styles - adjusted to match nav container */
  .container {
    max-width: 1200px; /* Match nav container */
    margin: 0 auto;
    padding: 0 2rem; /* Match nav padding */
  }

  /* Contact Section */
  .contact-section {
    padding: 5rem 0;
    background-color: #000;
    position: relative;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  /* Contact Info */
  .contact-heading {
    font-size: 1.2rem;
    color: #e7c980;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }

  .contact-subheading {
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 2.5rem;
    font-weight: 600;
  }

  .contact-details {
    margin-bottom: 2.5rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    background-color: rgba(231, 201, 128, 0.1);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #e7c980;
    font-size: 1rem;
    margin-right: 1rem;
    flex-shrink: 0;
  }

  .booking-label {
    color: #e7c980;
    opacity: 0.9;
    font-weight: 400;
    margin-right: 0.5rem;
  }

  .contact-text {
    color: #fff;
    font-size: 1rem;
    line-height: 1.6;
  }

  .contact-text a {
    color: #fff;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-text a:hover {
    color: #e7c980;
  }

  /* Business Hours */
  .business-hours {
    margin-bottom: 2.5rem;
  }

  .hours-heading {
    font-size: 1.2rem;
    color: #e7c980;
    margin-bottom: 1rem;
  }

  .hours-text {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .hours-note {
    color: #999;
    font-size: 0.9rem;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(231, 201, 128, 0.1);
    color: #e7c980;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background-color: #e7c980;
    color: #000;
    transform: translateY(-3px);
  }

  /* Contact Form */
  .contact-form-container {
    background-color: rgba(20, 20, 20, 0.5);
    border: 1px solid rgba(231, 201, 128, 0.3);
    border-radius: 8px;
    padding: 3rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-field {
    position: relative;
  }

  .field-icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 50px;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #e7c980;
    font-size: 1rem;
  }

  .contact-form input {
    width: 100%;
    padding: 15px 15px 15px 50px;
    font-size: 1rem;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid rgba(231, 201, 128, 0.3);
    color: #fff;
    transition: border-color 0.3s ease;
  }

  .contact-form input:focus {
    outline: none;
    border-color: #e7c980;
  }

  .contact-form input::placeholder {
    color: #999;
  }

  .contact-form textarea {
    width: 100%;
    padding: 15px 15px 15px 50px;
    font-size: 1rem;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid rgba(231, 201, 128, 0.3);
    color: #fff;
    transition: border-color 0.3s ease;
    resize: vertical;
    min-height: 100px;
  }

  .contact-form textarea:focus {
    outline: none;
    border-color: #e7c980;
  }

  .contact-form textarea::placeholder {
    color: #999;
  }

  .submit-btn {
    background-color: #d4af37; /* Match nav button color */
    color: #000;
    border: none;
    padding: 0.75rem 1.5rem; /* Match nav button padding */
    font-size: 0.9rem; /* Match nav button font size */
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    margin-top: 1rem;
    letter-spacing: 0.5px; /* Match nav button letter spacing */
  }

  .submit-btn:hover {
    background-color: #c5a028; /* Match nav button hover color */
    transform: translateY(-2px); /* Match nav button hover transform */
  }

  /* Map Section - Full Width but aligned contents */
  .map-section {
    width: 100%;
    height: 500px;
  }

  .map-container {
    width: 100%;
    height: 100%;
  }

  /* Responsive Styles */
  @media (max-width: 1024px) {
    .contact-container {
      gap: 3rem;
    }

    .contact-form-container {
      padding: 2rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1rem; /* Match nav mobile padding */
    }

    .page-banner {
      margin-top: 100px; /* Account for smaller mobile nav */
      padding: 6rem 0 3rem;
    }

    .page-title {
      font-size: 2.5rem;
    }

    .contact-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-subheading {
      font-size: 2rem;
    }

    .map-section {
      height: 400px;
    }
  }

  @media (max-width: 480px) {
    .contact-section {
      padding: 3rem 0;
    }

    .page-title {
      font-size: 2rem;
    }

    .contact-subheading {
      font-size: 1.75rem;
      margin-bottom: 2rem;
    }

    .contact-form-container {
      padding: 1.5rem;
    }

    .contact-icon {
      width: 36px;
      height: 36px;
    }

    .map-section {
      height: 350px;
    }
  }

  /* Add these styles for date input compatibility */
  input[type="date"]::-webkit-calendar-picker-indicator {
    background: transparent;
    bottom: 0;
    color: transparent;
    cursor: pointer;
    height: auto;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    width: auto;
  }

  input[type="date"]::-webkit-inner-spin-button,
  input[type="date"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  input[type="date"] {
    -webkit-appearance: textfield;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  /* Ensure the date input matches other inputs */
  input[type="date"]::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Style for Safari and other browsers */
  @media screen and (-webkit-min-device-pixel-ratio: 0) {
    input[type="date"]:before {
      color: rgba(255, 255, 255, 0.6);
      content: attr(placeholder);
    }
    input[type="date"].has-value:before {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const contactForm = document.getElementById("contactForm");

    if (contactForm) {
      contactForm.addEventListener("submit", function (e) {
        e.preventDefault();

        // Get form values
        const nameInput = document.getElementById("name") as HTMLInputElement;
        const phoneInput = document.getElementById("phone") as HTMLInputElement;
        const emailInput = document.getElementById("email") as HTMLInputElement;
        const messageInput = document.getElementById(
          "message",
        ) as HTMLTextAreaElement;

        if (nameInput && phoneInput && emailInput && messageInput) {
          const name = nameInput.value;
          const phone = phoneInput.value;
          const email = emailInput.value;
          const message = messageInput.value;

          // Construct WhatsApp message
          const whatsappMessage = `Hello, my name is ${name}.\n\n${message}\n\nMy contact details:\nPhone: ${phone}\nEmail: ${email}`;

          // Construct WhatsApp URL with your number
          const whatsappURL = `https://wa.me/919960007937?text=${encodeURIComponent(whatsappMessage)}`;

          // Open WhatsApp
          window.open(whatsappURL, "_blank");
        }
      });

      // Add visual feedback for form inputs
      const inputs = document.querySelectorAll(
        ".contact-form input, .contact-form textarea",
      );
      inputs.forEach((input) => {
        input.addEventListener("focus", function () {
          this.parentElement?.classList.add("input-focus");
        });

        input.addEventListener("blur", function () {
          if (!(this as HTMLInputElement | HTMLTextAreaElement).value) {
            this.parentElement?.classList.remove("input-focus");
          }
        });
      });
    }
  });
</script>
