---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import WallOfFame from '../components/WallOfFame.astro';

import RussianDance from '../assets/entertainment/banner/banner_two.jpeg';
import EntertainmentBanner from '../assets/entertainment/banner/banner_four.jpeg';
import CelebrityBanner from '../assets/entertainment/banner/banner_one.png';
import DailyGiveAways from '../assets/entertainment/daily/daily_giveaways.jpeg';
import LivePerformances from '../assets/entertainment/daily/live.jpeg';
import RussianDancer from '../assets/entertainment/daily/russian_dancer.jpeg';
import FreeOTPC from '../assets/entertainment/upcoming/free-otpc.png';
import kangna600 from '../assets/entertainment/upcoming/kangna600.png';

// Daily Entertainment Data
const dailyEntertainment = [
  {
    title: "Russian Dancers",
    description: "Experience the art and elegance of Russian dancers as they perform traditional and contemporary routines that captivate and mesmerize.",
    image: RussianDancer,
    alt: "Russian dancers performing live at Phoenix Casino Goa, Best Casino in goa for gaming and entertainment"
  },
  {
    title: "Live Music & Bollywood Dance",
    description: "Enjoy electrifying live music performances by talented artists and bands, creating the perfect ambience for your casino experience.",
    image: LivePerformances,
    alt: "Live Bollywood music and dance with bollywood celebrities at Phoenix Casino stage"
  },
  {
    title: "Live Games & Giveaways",
    description: "Participate in exciting live games and stand a chance to win amazing prizes in our regular giveaways throughout the evening.",
    image: DailyGiveAways,
    alt: "Guests enjoying live casino games and prize giveaways at casino in goa, Phoenix casino goa"
  },
];

// Upcoming Events Data
const upcomingEvents = [
  {
    title: "Free 500 OTPC",
    description: "Get Free 500 OTPC on our entry packages (T&C apply).",
    image: FreeOTPC,
    alt: "Phoenix Casino offering free 500 OTPC promotional offer, Goa casino with offers"
  },
   {
title: "Celebrity Visit - 15th August",
    description: "Guest appreance by Kangna Sharma with Live performances.",
    image: kangna600,
    }
];

// Past Events Data
const pastEvents = [
  {
    title: "New Year's Eve Bash",
    description: "Our spectacular New Year celebration featuring celebrity performances and breathtaking fireworks.",
    video: "https://www.youtube.com/embed/oMvX-g5jKxE",
    date: "Dec 31, 2024",
  },
  {
    title: "Celebrity Night Extravaganza",
    description: "A dazzling fashion showcase feat. Urvashi Rautela, Sonal Chauhan & Amyra Uttam.",
    video: "https://youtube.com/embed/yzPjaQ8jrtQ",
    date: "Feb 20, 2025",
  },
  {
    title: "Bikes & Bets Bash",
    description: "3 days, 3 lucky winners, & Countless memories at the Bikes & Bets Bash! ",
    video: "https://www.youtube.com/embed/X1eCfUJ4eQo",
    date: "May 2-4th, 2025",
  },
  {
    title: "Anup Jalota Ghazal Performance",
    description: "Check out Ghazal night and phoenix casino goa with Anup and Jalota and his lovely performance",
    video: "https://www.youtube.com/embed/g_1y0aciAj0",
    date: "15th July",
  },
];

// Banner Slides Data
const bannerSlides = [
  {
    image: EntertainmentBanner,
    alt: "Casino in goa for entertainment and gaming, Phoenix Casino Goa",
    title: "EXPERIENCE THE MAGIC",
    subtitle: "Unforgettable entertainment experiences await you",
  },
  {
    image: RussianDance,
    alt: "Models performing live at the top casino in goa, Phoenix casino in goa ",
    title: "LIVE PERFORMANCES",
    subtitle: "Enjoy electrifying shows by talented artists",
  },
  {
    image: CelebrityBanner,
    alt: "Famous bollywood celebrities enjoying at goa casino, Phoenix casino is the best casino in goa",
    title: "CELEBRITY APPEARANCES",
    subtitle: "Meet your favorite stars at our exclusive events",
  },
];
---

<Layout title="Entertainment | Phoenixx Casino">
  <!-- Banner Section -->
  <section class="entertainment-banner">
    <div class="banner-slider">
      <div class="slides-container">
        {bannerSlides.map((slide, idx) => (
          <div class="slide" data-index={idx}>
            <Image
              src={slide.image}
              alt={slide.alt || slide.title}
              width={1400}
              height={600}
              class="slide-image"
            />
            <div class="slide-content">
              <h1>{slide.title}</h1>
              <p>{slide.subtitle}</p>
            </div>
          </div>
        ))}
      </div>
      <button class="banner-nav prev" aria-label="Previous slide">❮</button>
      <button class="banner-nav next" aria-label="Next slide">❯</button>
      <div class="banner-dots">
        {bannerSlides.map((_, idx) => (
          <button class="dot" data-index={idx} aria-label={`Go to slide ${idx + 1}`}></button>
        ))}
      </div>
    </div>
  </section>

  <!-- Daily Entertainment Section -->
  <section id="daily-entertainment" class="daily-entertainment">
    <div class="container">
      <h2 class="section-title">DAILY ENTERTAINMENT</h2>
      <p class="section-subtitle">Experience the vibrant entertainment offerings at Phoenixx Casino</p>
      <div class="entertainment-grid">
        {dailyEntertainment.map((item, idx) => (
          <div class="entertainment-card">
            <Image
              src={item.image}
              alt={item.alt || item.title}
              width={600}
              height={400}
              class="card-img"
            />
            <div class="card-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Upcoming Events Section -->
  <section id="upcoming-events" class="upcoming-events">
    <div class="container">
      <h2 class="section-title">UPCOMING EVENTS</h2>
      <p class="section-subtitle">Mark your calendar for these exciting upcoming events</p>
      <div class="entertainment-grid">
        {upcomingEvents.map((event, idx) => (
          <a href="/contact" class="entertainment-card">
            <Image
              src={event.image}
              alt={event.alt || event.title}
              width={600}
              height={400}
              class="card-img"
            />
            <div class="card-content">
              <h3>{event.title}</h3>
              <p>{event.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Past Events Section -->
  <section id="past-events" class="past-events">
    <div class="container">
      <h2 class="section-title">PAST EVENTS</h2>
      <p class="section-subtitle">Relive the magical moments from our past events</p>
      <div class="videos-container">
        <div class="videos-grid">
          {pastEvents.map((ev, idx) => (
            <div class="video-card">
              <div class="video-frame">
                <iframe
                  src={ev.video}
                  title={ev.title}
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="video-content">
                <h3>{ev.title}</h3>
                <p class="video-date">📅 {ev.date}</p>
                <p>{ev.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Celebrities Section -->
  <section id="celebrities">
    <WallOfFame />
  </section>
</Layout>


<style>
  .upcoming-events {
    text-align: center;
    padding: 4rem 0;
    background-color: var(--color-bg);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-title {
    font-size: 2.5rem;
    text-align: center;
    background: linear-gradient(90deg, #e7c980 0%, #9e8253 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    position: relative;
  }

  .section-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 3px;
    background-color: #D4AF37;
    margin: 1rem auto 0;
  }

  .section-subtitle {
    text-align: center;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 400;
    color: #e0e0e0;
    max-width: 800px;
    margin: 0 auto 4rem;
  }

  .entertainment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    justify-items: center;
  }

  .entertainment-card {
    background: #111111;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    width: 280px;
    text-align: center;
  }

  .entertainment-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
  }

  .card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .card-content {
    padding: 1rem;
    color: white;
  }

  .card-content h3 {
    font-size: 1.2rem;
    color: #D4AF37;
    margin: 0 0 0.4rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .card-content p {
    font-size: 0.9rem;
    color: #fff;
    margin: 0;
    opacity: 0.9;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }
    .entertainment-card {
      width: 240px;
    }
  }

  @media (max-width: 480px) {
    .entertainment-card {
      width: 220px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const slides = document.querySelectorAll('.slide');
  const dots = document.querySelectorAll('.dot');
  const prevBtn = document.querySelector('.prev');
  const nextBtn = document.querySelector('.next');
  
  let current = 0;
  
  const update = () => {
    slides.forEach((s, i) => {
      if (s instanceof HTMLElement) {
        s.style.opacity = i === current ? '1' : '0';
      }
    });
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  };
  
  if (prevBtn) {
    prevBtn.addEventListener('click', () => { 
      current = (current - 1 + slides.length) % slides.length; 
      update(); 
    });
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', () => { 
      current = (current + 1) % slides.length; 
      update(); 
    });
  }
  
  dots.forEach((d, i) => d.addEventListener('click', () => { 
    current = i; 
    update(); 
  }));
  
  update();
  setInterval(() => { 
    current = (current + 1) % slides.length; 
    update(); 
  }, 5000);
});
</script>
