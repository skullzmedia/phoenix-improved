</html>
<style is:global>
  html {
    font-family: var(--font-family-base);
    background: var(--color-bg);
    color: var(--color-text);
    scroll-behavior: smooth;
  }
  * {
    box-sizing: border-box;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>
