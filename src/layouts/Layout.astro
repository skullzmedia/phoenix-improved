      content="LezJkVpCUXJUHxLCkSEIlh-hnUr6RwWv3Qs8tc8niKI"
    />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta
      name="description"
      content={description ||
        "Phoenixx Group Goa - Luxury Entertainment Hub in Candolim at Hilton Goa Resort"}
    />
    <!-- ✅ Canonical Tag: Add this -->
    <link
      rel="canonical"
      href={`https://www.phoenixcasino.in${Astro.url.pathname}`}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://phoenixcasino.in/" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description ||
        "Phoenixx Group Goa - Luxury Entertainment Hub in Candolim at Hilton Goa Resort"}
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://phoenixcasino.in/" />
    <meta property="twitter:title" content={title} />
    <meta
      property="twitter:description"
      content={description ||
        "Phoenixx Group Goa - Luxury Entertainment Hub in Candolim at Hilton Goa Resort"}
